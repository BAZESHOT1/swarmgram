# ============================================================
#  .env узла Klinto  ->  скопировать как .env рядом с docker-compose.node.yml
# ============================================================

# --- Главный сервер (вшито, менять не нужно) ---
MAIN_SERVER_URL=http://150.251.143.212:8080

# --- Владелец узла: ваш username в Klinto ---
OWNER_USERNAME=your_username

# --- Токен привязки: создаётся в клиенте (Профиль -> Мои узлы), живёт 30 минут ---
NODE_CLAIM_TOKEN=

# --- Как Hub и клиенты будут стучаться к этому узлу ---
# На своём сервере: http://IP_СЕРВЕРА:9090 ; по умолчанию порт 9090
NODE_PUBLIC_URL=http://YOUR_SERVER_IP:9090
NODE_PORT_HOST=9090

# --- Профиль узла ---
NODE_NAME=my-klinto-node
NODE_REGION=eu
NODE_CAPACITY_GB=20
