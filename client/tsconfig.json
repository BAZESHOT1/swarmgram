{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "react-native"
    ]
  },
  "include": [
    "index.web.tsx",
    "index.native.tsx",
    "src",
    "vite.config.ts"
  ],
  "extends": "expo/tsconfig.base"
}
