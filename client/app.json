{
  "expo": {
    "name": "SwarmGram",
    "slug": "swarmgram",
    "version": "1.3.9",
    "orientation": "portrait",
    "scheme": "swarmgram",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "jsEngine": "hermes",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0E14",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "SwarmGram подключается к модулям связи по Bluetooth для работы mesh-сети."
        }
      ],
      "expo-sqlite",
      "expo-build-properties"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swarmgram.app",
      "buildNumber": "10309",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "SwarmGram подключается к модулям связи по Bluetooth для работы mesh-сети.",
        "NSBluetoothPeripheralUsageDescription": "SwarmGram использует Bluetooth для связи с носимыми модулями."
      }
    },
    "android": {
      "package": "com.swarmgram.app",
      "versionCode": 10309,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E14"
      },
      "permissions": [
        "INTERNET",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "https://api.swarmgram.io/api"
    }
  }
}
