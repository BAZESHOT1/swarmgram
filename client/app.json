{
  "expo": {
    "name": "Klinto",
    "slug": "klinto",
    "version": "1.10.1",
    "orientation": "portrait",
    "scheme": "klinto",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "jsEngine": "hermes",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0E14",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "googleServicesFile": "./google-services.json"
          },
          "ios": {
            "googleServicesFile": "./GoogleService-Info.plist",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "react-native-background-fetch",
      "./plugins/withNotifeeForegroundService",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Klinto подключается к модулям связи по Bluetooth для работы mesh-сети."
        }
      ],
      "expo-sqlite",
      "expo-build-properties"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pink-project.kintoapp",
      "buildNumber": "11001",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Klinto подключается к модулям связи по Bluetooth для работы mesh-сети.",
        "NSBluetoothPeripheralUsageDescription": "Klinto использует Bluetooth для связи с носимыми модулями.",
        "UIBackgroundModes": ["fetch", "remote-notification", "bluetooth-central"],
        "FirebaseAppDelegateProxyEnabled": true
      }
    },
    "android": {
      "package": "com.pink_project.kintoapp",
      "versionCode": 11001,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E14"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "https://150-251-143-212.nip.io:3443/api"
    }
  }
}
