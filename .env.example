# ---------- Главный сервер ----------
# Публичный адрес Hub (подставлен IP вашего главного сервера)
HUB_PUBLIC_URL=http://150.251.143.212:8080

# PostgreSQL
POSTGRES_USER=swarm
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=swarm

# Секреты Hub (ОБЯЗАТЕЛЬНО заменить!)
HUB_JWT_SECRET=change_me_random_64_chars_secret_value_here_0123456789
HUB_ADMIN_TOKEN=change_me_admin_token

# Репликация и лимиты
HUB_REPLICAS=3
HUB_MAX_UPLOAD_MB=25
HUB_ALLOW_OPEN_NODES=false

# Почта (письма подтверждения / сброс пароля). Пусто = письма печатаются в лог
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SwarmGram <noreply@swarmgram.local>
